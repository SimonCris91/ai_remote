# Server-side only. Never put this value in Flutter or use --dart-define for it.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_RESPONSES_MODEL=gpt-4.1-mini

# Google Sign-In ID-token validation (the audience is the public Web OAuth client ID).
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=your-web-client-id.apps.googleusercontent.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ALLOWED_EMAIL=you@gmail.com

# Personal non-Google mode. Keep both values server-side; never put them in
# Flutter or in --dart-define. The phone exchanges the pairing code once over
# HTTPS and stores only the returned short-lived session token.
AI_REMOTE_AUTH_MODE=pairing
AI_REMOTE_PAIRING_CODE=
AI_REMOTE_SESSION_SECRET=

# Local development only. The backend enforces loopback when this is true.
ALLOW_INSECURE_DEV_AUTH=false
HOST=127.0.0.1
PORT=8787

# Optional local Codex App Server bridge. The backend uses the Codex CLI login
# store from CODEX_HOME. Never pass CLI credentials to Flutter or the API.
CODEX_APP_SERVER_ENABLED=false
CODEX_BINARY=codex
CODEX_WORKSPACE_ROOT=
# Public Flutter build configuration, comma-separated channel ids. Example:
# AI_REMOTE_CODEX_CHANNELS=lavormetal-daily,technical-agent
